# Optional for the anonymous Cloudflare Worker; existing values preserve sessions.
# When absent, Worker derives a domain-separated signing key from ARTBOARD_V031_TOKEN.
# Required for the separate legacy Python gateway. Never commit secrets.
MYJERSEY_ACCESS_TOKEN=
# Legacy Python gateway only; Cloudflare uses a signed per-browser identity.
MYJERSEY_ARTBOARD_PRINCIPAL=
ARTBOARD_V031_URL=
ARTBOARD_V031_TOKEN=
FRAMEFORGE_URL=
FRAMEFORGE_TOKEN=
ASSETSX_URL=
ASSETSX_TOKEN=
AUTOFLY_URL=
AUTOFLY_TOKEN=
# Local development ONLY; allows http://127.0.0.1 upstreams.
MYJERSEY_ALLOW_LOCAL_HTTP=0
