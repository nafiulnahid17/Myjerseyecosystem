{
  "name": "myjerseyecosystem",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "10051",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "AI_LIMITER",
      "namespace_id": "10052",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ]
}
