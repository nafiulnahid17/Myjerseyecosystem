{
  "name": "myjerseyecosystem",
  "main": "src/cloudflare.mjs",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/production-studio",
      "/production-studio/production/*",
      "/production-studio/export/*",
      "/artboard",
      "/artboard-ai",
      "/_pipeline",
      "/_pipeline/*"
    ]
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "10051",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "AI_LIMITER",
      "namespace_id": "10052",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
